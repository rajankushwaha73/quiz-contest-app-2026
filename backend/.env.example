PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/quiz_contest_app

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

# Email (for password reset) - using Gmail SMTP as an example.
# EMAIL_USER: your full Gmail address
# EMAIL_PASS: a Gmail "App Password" (NOT your regular Gmail password) -
#             generate one at https://myaccount.google.com/apppasswords
#             (requires 2-Step Verification to be enabled on the account)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM="Quiz Contest <your_email@gmail.com>"

# Google Gemini AI & RAG Question Generation (Isolated feature)
# Teacher uploads a PDF -> Text is extracted, cleaned, chunked, and embedded into MongoDB Atlas
# Vector Search using gemini-embedding-2 (768 dimensions) -> Relevant chunks retrieved ->
# Gemini generates grounded MCQ questions from retrieved chunks.
# Leave GEMINI_API_KEY empty to keep this feature gracefully disabled; the rest of the application runs normally.
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# MongoDB Atlas Vector Search Index Name (configured in Atlas Search)
ATLAS_VECTOR_INDEX_NAME=vector_index
